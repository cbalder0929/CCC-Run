# Copy to .env.local and fill in when wiring up real integrations.
# None of these are required to run the app locally — every service below
# falls back to an in-memory mock implementation until configured.

# Google Calendar API / OAuth (see lib/calendar/google.ts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Graph / Outlook Calendar (see lib/calendar/microsoft.ts)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email provider, e.g. Resend / Mailchimp / SendGrid (see lib/email/service.ts)
EMAIL_PROVIDER_API_KEY=

# Twilio SMS (see lib/sms/service.ts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Database, e.g. Supabase/Postgres (see lib/data/events.ts)
DATABASE_URL=
